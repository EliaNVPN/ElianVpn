<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive data from cloud backup -->
        <exclude domain="sharedpref" path="notification_preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Include user preferences in device transfer -->
        <include domain="sharedpref" path="user_preferences.xml" />
    </device-transfer>
</data-extraction-rules>