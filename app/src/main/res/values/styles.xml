<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    
    <!-- Base application theme -->
    <style name="Theme.SamoanBible" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/primary_color</item>
        <item name="colorPrimaryVariant">@color/primary_dark_color</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorSecondary">@color/accent_color</item>
        <item name="colorSecondaryVariant">@color/accent_dark_color</item>
        <item name="colorOnSecondary">@color/text_on_accent</item>
        <item name="android:colorBackground">@color/background_color</item>
        <item name="colorSurface">@color/surface_color</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:statusBarColor">@color/primary_dark_color</item>
        <item name="android:navigationBarColor">@color/primary_color</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    
    <!-- NoActionBar theme for main activity -->
    <style name="Theme.SamoanBible.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    
    <!-- AppBar theme -->
    <style name="Theme.SamoanBible.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.SamoanBible.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
    
    <!-- Card Styles -->
    <style name="CardView.Bible" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="cardPreventCornerOverlap">false</item>
        <item name="android:layout_margin">@dimen/card_margin</item>
    </style>
    
    <!-- Daily Verse Card -->
    <style name="CardView.DailyVerse" parent="CardView.Bible">
        <item name="cardElevation">@dimen/daily_verse_card_elevation</item>
        <item name="cardCornerRadius">@dimen/daily_verse_card_corner_radius</item>
        <item name="android:layout_margin">@dimen/daily_verse_card_margin</item>
    </style>
    
    <!-- Text Styles -->
    <style name="TextAppearance.SamoanBible.Headline" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">@dimen/text_size_headline</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">serif</item>
    </style>
    
    <style name="TextAppearance.SamoanBible.Title" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">serif</item>
    </style>
    
    <style name="TextAppearance.SamoanBible.Subtitle" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    
    <style name="TextAppearance.SamoanBible.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">@dimen/text_size_normal</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingExtra">@dimen/verse_text_line_spacing</item>
    </style>
    
    <!-- Verse Text Styles -->
    <style name="TextAppearance.SamoanBible.Verse" parent="TextAppearance.SamoanBible.Body">
        <item name="android:textSize">@dimen/verse_text_size_normal</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:fontFamily">serif</item>
    </style>
    
    <style name="TextAppearance.SamoanBible.Verse.Samoan" parent="TextAppearance.SamoanBible.Verse">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">normal</item>
    </style>
    
    <style name="TextAppearance.SamoanBible.Verse.English" parent="TextAppearance.SamoanBible.Verse">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textStyle">italic</item>
    </style>
    
    <style name="TextAppearance.SamoanBible.VerseNumber" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/verse_number_size</item>
        <item name="android:textColor">@color/accent_color</item>
        <item name="android:textStyle">bold</item>
    </style>
    
    <!-- Button Styles -->
    <style name="Button.SamoanBible" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="backgroundTint">@color/primary_color</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:paddingStart">@dimen/button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/button_padding_horizontal</item>
    </style>
    
    <style name="Button.SamoanBible.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/primary_color</item>
        <item name="strokeColor">@color/primary_color</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:paddingStart">@dimen/button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/button_padding_horizontal</item>
    </style>
    
    <style name="Button.SamoanBible.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/primary_color</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:paddingStart">@dimen/button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/button_padding_horizontal</item>
    </style>
    
    <!-- Action Button Styles -->
    <style name="Button.SamoanBible.Action" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/accent_color</item>
        <item name="android:layout_width">@dimen/action_button_size</item>
        <item name="android:layout_height">@dimen/action_button_size</item>
        <item name="android:layout_margin">@dimen/action_button_margin</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">@dimen/margin_small</item>
    </style>
    
    <!-- Toolbar Styles -->
    <style name="Toolbar.SamoanBible" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:layout_height">@dimen/toolbar_height</item>
        <item name="android:elevation">@dimen/toolbar_elevation</item>
        <item name="titleTextAppearance">@style/TextAppearance.SamoanBible.Title</item>
        <item name="android:theme">@style/Theme.SamoanBible.AppBarOverlay</item>
        <item name="popupTheme">@style/Theme.SamoanBible.PopupOverlay</item>
    </style>
    
    <!-- FAB Styles -->
    <style name="FloatingActionButton.SamoanBible" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/accent_color</item>
        <item name="tint">@color/text_on_accent</item>
        <item name="android:layout_margin">@dimen/fab_margin</item>
    </style>
    
    <!-- Book List Item Styles -->
    <style name="ListItem.Book" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/list_item_height</item>
        <item name="android:padding">@dimen/list_item_padding</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    
    <!-- Chapter Grid Item Styles -->
    <style name="GridItem.Chapter" parent="CardView.Bible">
        <item name="android:layout_width">@dimen/chapter_grid_item_size</item>
        <item name="android:layout_height">@dimen/chapter_grid_item_size</item>
        <item name="android:layout_margin">@dimen/chapter_grid_spacing</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>
    
    <!-- Divider Styles -->
    <style name="Divider.SamoanBible" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/divider_height</item>
        <item name="android:background">@color/divider_color</item>
        <item name="android:layout_marginStart">@dimen/divider_margin</item>
        <item name="android:layout_marginEnd">@dimen/divider_margin</item>
    </style>
    
    <!-- BottomNavigationView Style -->
    <style name="BottomNavigationView.SamoanBible" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:layout_height">@dimen/bottom_nav_height</item>
        <item name="android:background">@color/surface_color</item>
        <item name="itemIconTint">@color/primary_color</item>
        <item name="itemTextColor">@color/primary_color</item>
        <item name="android:elevation">@dimen/toolbar_elevation</item>
    </style>
    
    <!-- TabLayout Style -->
    <style name="TabLayout.SamoanBible" parent="Widget.MaterialComponents.TabLayout">
        <item name="android:background">@color/primary_color</item>
        <item name="tabTextColor">@color/text_on_primary</item>
        <item name="tabSelectedTextColor">@color/text_on_primary</item>
        <item name="tabIndicatorColor">@color/accent_color</item>
        <item name="tabIndicatorHeight">3dp</item>
    </style>
    
    <!-- Progress Bar Style -->
    <style name="ProgressBar.SamoanBible" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressTint">@color/primary_color</item>
        <item name="android:progressBackgroundTint">@color/primary_light_color</item>
    </style>
    
</resources>